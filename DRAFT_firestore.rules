rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check - strictly checking email and verification
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'ebisamagarsaa@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && 
                      incoming().uid == userId &&
                      incoming().keys().hasAll(['uid', 'email', 'createdAt']) &&
                      incoming().isAdmin == false; // Prevent self-promoting to admin
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
                      incoming().uid == existing().uid;
    }

    // --- Conversations ---
    function isValidConversation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.model is string;
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidConversation(incoming()) && 
                      incoming().id == conversationId;
      allow update: if isOwner(existing().userId) && isValidConversation(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt', 'model']);
      allow delete: if isOwner(existing().userId) || isAdmin();

      // --- Messages ---
      function isValidMessage(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.conversationId == conversationId &&
               data.userId == request.auth.uid &&
               data.role in ['user', 'assistant'] &&
               data.content is string && data.content.size() <= 10000;
      }

      match /messages/{messageId} {
        // Evaluate against parent ownership or admin status
        // Pillar 8: evaluate resource.data against request.auth.uid to force secure queries
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        
        allow create: if isSignedIn() && isValidMessage(incoming()) &&
                        incoming().id == messageId &&
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        
        allow update, delete: if false; // Messages are immutable in this flow
      }
    }
  }
}
